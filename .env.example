# Beispiel-Konfiguration. Kopieren nach `.env` und ausfuellen:
#
#   cp .env.example .env
#
# Auf Render gehoeren diese Werte stattdessen unter "Environment" ins Dashboard.
# NIEMALS echte Werte in diese Datei schreiben — sie liegt im Repository.

# ── Pflicht ────────────────────────────────────────────────────────────
# Ohne diese fuenf bricht der Preflight den Start mit Klartext ab.

# Turso-Datenbank. URL und Token aus dem Turso-Dashboard.
# Der Token braucht Read & Write; Expiry am besten "Never".
DATABASE_URL=libsql://deine-datenbank.turso.io
DATABASE_KEY=

# Passwort fuer das Web-Panel. Mindestens 16 Zeichen — dahinter liegen Kick,
# Ban, Rundnachrichten und "Alle Daten loeschen".
# Vorschlag erzeugen:  openssl rand -base64 24
ACCESS_SECRET=

# Telefonnummern der Owner, international und nur Ziffern, per Komma getrennt.
# Owner duerfen den Bot per DM bedienen und in Gruppen freischalten.
OWNER_NUMBERS=491701234567

# Oeffentliche Adresse des Dienstes, inklusive Protokoll. Der Bot pingt
# davon /health alle 30 Sekunden selbst an, damit der Render-Free-Tier
# nicht einschlaeft.
SELF_URL=https://dein-bot.onrender.com

# ── Optional ───────────────────────────────────────────────────────────

# Anzeigename des Bots. Default: CommunityBot
BOT_NAME=CommunityBot

# Bot-Owner duerfen zusaetzlich die bot-weiten Befehle (Wartungsmodus,
# Neustart). Leer gelassen uebernehmen die OWNER_NUMBERS diese Rolle.
BOT_OWNER_NUMBERS=

# Gemini-Schluessel. Leer gelassen laeuft der Bot ohne KI — der Fallback fuer
# unbekannte Befehle antwortet dann mit dem Hilfe-Hinweis.
GEMINI_API_KEY=

# Modellwahl. Das Primaermodell wird nur fuer komplexe Anfragen benutzt,
# sonst und bei Ausfall das Fallback.
GEMINI_MODEL_PRIMARY=gemini-2.0-flash-exp
GEMINI_MODEL_FALLBACK=gemini-1.5-flash

# Zeitzone. Bestimmt Tagesgrenzen fuer Statistik und KI-Kontingent sowie die
# Uhrzeiten von Nachtmodus, Geburtstagen und Wochenreport. Default: Europe/Berlin
TZ=Europe/Berlin

# Auf 1 setzen fuer zusaetzliche Debug-Ausgaben.
DEBUG=

# PORT NICHT setzen. Auf Render kommt der Wert von der Plattform; lokal
# faellt der Bot auf 3000 zurueck.
